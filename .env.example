# ══════════════════════════════════════════════
# 🤖 ResolveAI — Environment Variables
# ══════════════════════════════════════════════

# Database
DATABASE_URL=postgresql+asyncpg://resolveai:resolveai@postgres:5432/resolveai
DATABASE_URL_SYNC=postgresql://resolveai:resolveai@postgres:5432/resolveai

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Asana
ASANA_ACCESS_TOKEN=your-asana-personal-access-token
ASANA_PROJECT_ID=your-asana-project-id

# GitHub
GITHUB_TOKEN=ghp_your-github-token
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# App
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:3000
